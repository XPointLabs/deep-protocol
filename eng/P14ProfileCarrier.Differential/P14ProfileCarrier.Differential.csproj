<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\..\vendor\p14-profile-carrier\packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <Target Name="RequirePinnedXNodeRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(XNodeRoot)' == ''"
           Text="XNodeRoot must point to the repository pinned by the provenance manifest." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deep.Protocol.ProfileCarrier\Deep.Protocol.ProfileCarrier.csproj" />
    <ProjectReference Include="$(XNodeRoot)\src\XNode.ProfileGenerator\XNode.ProfileGenerator.csproj" />
    <Compile Include="$(XNodeRoot)\tests\XNode.ProfileGenerator.Tests\TestOnlyProfileFixture.cs"
             Link="PinnedXNode\TestOnlyProfileFixture.cs" />
  </ItemGroup>

</Project>
