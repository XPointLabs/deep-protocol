{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XPointLabs/deep-protocol/blob/main/eng/production-protocol-closure.policy.schema.json",
  "title": "Deep production protocol closure policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "repositoryUrl",
    "repositoryType",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "./production-protocol-closure.policy.schema.json"
    },
    "schema": {
      "const": "deep-production-protocol-closure-policy/v1"
    },
    "repositoryUrl": {
      "type": "string",
      "pattern": "^https://[^/?#]+(?:/[^/?#]+)+\\.git$"
    },
    "repositoryType": {
      "const": "git"
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^:*?\"<>|]+$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/canonicalId"
      }
    },
    "exactPackageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "version": {
          "type": "string",
          "pattern": "^\\[[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?\\]$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "lockFile",
        "targetFramework",
        "packageReferences",
        "projectReferences",
        "packInputs",
        "packTargets"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "project": {
          "$ref": "#/$defs/relativePath"
        },
        "lockFile": {
          "$ref": "#/$defs/relativePath"
        },
        "targetFramework": {
          "const": "net10.0"
        },
        "packageReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactPackageReference"
          }
        },
        "projectReferences": {
          "$ref": "#/$defs/stringSet"
        },
        "packInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:build:[A-Za-z0-9.-]+|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^:*?\"<>|]+)$"
          }
        },
        "packTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    }
  }
}
