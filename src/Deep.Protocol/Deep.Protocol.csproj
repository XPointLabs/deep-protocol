<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/Deep.Protocol</PathMap>
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/XPointLabs/deep-protocol.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RecoveryTestSeam)' == 'true'">
    <DefineConstants>$(DefineConstants);DEEP_PROTOCOL_RECOVERY_TEST_SEAM</DefineConstants>
    <OutputPath>bin\$(Configuration)\test-seam\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\test-seam\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MlKemAndroidProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);DEEP_MLKEM_ANDROID_PROBE</DefineConstants>
    <OutputPath>bin\$(Configuration)\mlkem-android-probe\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\mlkem-android-probe\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sodium.Core" Version="[1.4.1]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Identity\Resources\Bip39\english.txt"
                      LogicalName="Deep.Protocol.Identity.Resources.Bip39.english.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="runtimes\win-x64\native\deep_mlkem.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="runtimes/win-x64/native" />
    <Content Include="runtimes\win-arm64\native\deep_mlkem.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="runtimes/win-arm64/native" />
  </ItemGroup>

  <ItemGroup Condition="'$(RecoveryTestSeam)' == 'true'">
    <InternalsVisibleTo Include="Deep.Protocol.MembershipRoutes.Tests" />
    <InternalsVisibleTo Include="Deep.Protocol.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(MlKemAndroidProbe)' == 'true'">
    <InternalsVisibleTo Include="Deep.MlKem.AndroidProbe" />
  </ItemGroup>

</Project>
