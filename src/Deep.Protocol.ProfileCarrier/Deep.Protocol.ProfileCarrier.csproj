<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Deep.Protocol.ProfileCarrier</PackageId>
    <Description>Dormant exact DPF1 carrier and activation trust prerequisites over the pinned P04 authority.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.2.0-p14.local</Version>
    <DeepProtocolPackageVersion Condition="'$(DeepProtocolPackageVersion)' == ''">[0.3.0-p04.b887fa0]</DeepProtocolPackageVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/Deep.Protocol.ProfileCarrier</PathMap>
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/XPointLabs/deep-protocol.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\..\vendor\p14-profile-carrier\packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deep.Protocol" Version="$(DeepProtocolPackageVersion)" />
    <PackageReference Include="libsodium" Version="[1.0.22]" />
    <PackageReference Include="Sodium.Core" Version="[1.4.1]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
