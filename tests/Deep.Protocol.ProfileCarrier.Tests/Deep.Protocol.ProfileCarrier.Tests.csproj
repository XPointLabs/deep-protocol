  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deep.Protocol.ProfileCarrier\Deep.Protocol.ProfileCarrier.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Vectors\dpf1-v1.golden.json"
          CopyToOutputDirectory="PreserveNewest" />
